---
import { processSteps, type ProcessStep } from '../data/processSteps';

interface Props {
  steps?: ProcessStep[];
}

const { steps = processSteps } = Astro.props;
---

<div class="reveal">
  <div class="flex flex-col sm:flex-row sm:items-start">
    {
      steps.map((step, i) => (
        <>
          <div class="process-node">
            <button
              type="button"
              class="process-node-trigger"
              aria-expanded="false"
            >
              <span class="process-icon">
                {step.icon === 'pencil' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                  </svg>
                )}
                {step.icon === 'search' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <path d="m20 20-4.3-4.3" />
                    <path d="M10.5 7.5v1.5M10.5 13v.01M9.7 9.3a1 1 0 0 1 1.9.4c0 1-1.1 1-1.1 2" />
                  </svg>
                )}
                {step.icon === 'chart' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 21h18" />
                    <rect x="6" y="11" width="3.5" height="10" />
                    <rect x="13.5" y="6" width="3.5" height="15" />
                    <path d="M3 21V10l4-3 4 2 4-4 6 5" />
                  </svg>
                )}
                {step.icon === 'target' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <circle cx="12" cy="12" r="5" />
                    <circle cx="12" cy="12" r="1" />
                  </svg>
                )}
                {step.icon === 'shield' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3 4.5 6v6c0 4.5 3 7.5 7.5 9 4.5-1.5 7.5-4.5 7.5-9V6Z" />
                    <path d="m10 10-1.5 3H12l-1.5 3" />
                  </svg>
                )}
                {step.icon === 'refresh' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 12a9 9 0 0 1 15.3-6.4L21 8" />
                    <path d="M21 3v5h-5" />
                    <path d="M21 12a9 9 0 0 1-15.3 6.4L3 16" />
                    <path d="M3 21v-5h5" />
                  </svg>
                )}
                {step.icon === 'wireframe' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2" />
                    <path d="M3 9h18" />
                    <path d="M7 13h5M7 16h8" />
                  </svg>
                )}
                {step.icon === 'terminal' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2" />
                    <path d="m7 9 3 3-3 3" />
                    <path d="M13 15h4" />
                  </svg>
                )}
                {step.icon === 'branch' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 3v12" />
                    <circle cx="18" cy="6" r="3" />
                    <circle cx="6" cy="18" r="3" />
                    <path d="M18 9a9 9 0 0 1-9 9" />
                  </svg>
                )}
              </span>
              <span class="process-title">{step.title}</span>
            </button>
            <div class="process-desc-wrap">
              <div class="process-desc-inner">
                <p class="process-desc">{step.description}</p>
              </div>
            </div>
          </div>
          {i < steps.length - 1 && (
            <div class="process-connector" aria-hidden="true" />
          )}
        </>
      ))
    }
  </div>
</div>

<script>
  const nodes = document.querySelectorAll<HTMLElement>('.process-node');
  nodes.forEach((node) => {
    const trigger = node.querySelector<HTMLButtonElement>('.process-node-trigger');
    trigger?.addEventListener('click', () => {
      const isOpen = node.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });
  });
</script>
