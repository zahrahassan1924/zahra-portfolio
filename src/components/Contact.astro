---
const email = 'zahra.mhassan19@gmail.com';
const linkedin = 'https://www.linkedin.com/in/zahramhassan/';
const medium = 'https://medium.com/@zahrahassan1924';
const github = 'https://github.com/zahrahassan1924';
---

<section id="contact" class="py-24 px-6 sm:px-10 scroll-mt-16">
  <div class="max-w-[640px] mx-auto text-center reveal">
    <p class="pill-tag text-ink mb-6 inline-flex">Contact</p>
    <h2 class="font-serif text-2xl sm:text-3xl leading-tight text-ink mb-4">
      Reach out any time.
    </h2>
    <p class="text-ink/70 mb-10 max-w-[440px] mx-auto">
      The easiest ways to get in touch, or see more of the work.
    </p>

    <div class="flex items-center justify-center mb-8">
      <a href="/resume.pdf" download class="btn-hard btn-hard--accent">
        Download Resume
      </a>
    </div>

    <div class="flex items-center justify-center gap-3">
      <a
        href={`mailto:${email}`}
        aria-label="Email Zahra"
        class="icon-btn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 6-10 7L2 6" />
        </svg>
      </a>
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Zahra's LinkedIn profile"
        class="icon-btn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4V8h4v1.5A5.98 5.98 0 0 1 16 8Z" />
          <rect x="2" y="9" width="4" height="12" />
          <circle cx="4" cy="4" r="2" />
        </svg>
      </a>
      <a
        href={medium}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Zahra's Medium articles"
        class="icon-btn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="7" cy="12" r="4.5" />
          <ellipse cx="16" cy="12" rx="2.5" ry="4.5" />
          <ellipse cx="21.5" cy="12" rx="1" ry="4.5" />
        </svg>
      </a>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Zahra's GitHub profile"
        class="icon-btn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
        </svg>
      </a>
    </div>
  </div>
</section>
