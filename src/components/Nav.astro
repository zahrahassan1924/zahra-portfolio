---
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#how-i-use-ai', label: 'AI' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="fixed top-0 inset-x-0 z-50 bg-cream/90 backdrop-blur-sm border-b border-line">
  <nav class="max-w-6xl mx-auto flex items-center justify-between gap-4 px-4 sm:px-10 h-16">
    <a
      href="/"
      class="font-serif text-base sm:text-lg tracking-tight text-ink hover:opacity-75 transition-opacity whitespace-nowrap shrink-0"
    >
      Zahra Hassan
    </a>
    <ul class="flex items-center gap-3 sm:gap-8 shrink-0">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-xs sm:text-sm text-ink/80 hover:text-ink hover:bg-ink/10 rounded-full px-3 py-1.5 -mx-3 -my-1.5 transition-colors whitespace-nowrap"
            >
              <span class="sm:hidden">{link.label}</span>
              <span class="hidden sm:inline">
                {link.label === 'AI' ? 'How I Use AI' : link.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
